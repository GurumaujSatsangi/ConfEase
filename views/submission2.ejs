<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>DEI CMT</title>
    <link rel="shortcut icon" href="/dei_logo.png" type="image/x-icon">

    <link rel="stylesheet" href="/styles.css">
    
  </head>
  <body>
    <%- include('partials/dashboard/header') %>
<div class="container">
    

    <main>
        <h6>
          Join a Paper / Poster for
          <b
            ><%= conferences.title %>
            <p>Co-Author: <%=user.name %></p></b
          >
        </h6>
        <hr />
<form action="/join" method="POST" id="joinPaperForm">
    <div class="form-group">
    <input type="text" readonly hidden value="<%=conferences.conference_id %>" name="id" id="joinConferenceId" class="form-control" aria-describedby="emailHelp" placeholder="">
  </div>
  <div class="form-group">
    <label for="joinPaperCode">Enter the Paper Code</label>
    <input type="text" class="form-control" name="paper_code" id="joinPaperCode" aria-describedby="emailHelp" placeholder="">
  </div><br>

<input type="submit" class="btn btn-outline-primary" value="Join"></form>
<script>
  (function () {
    const form = document.getElementById('joinPaperForm');
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      const paperCode = document.getElementById('joinPaperCode').value.trim();
      const conferenceId = document.getElementById('joinConferenceId').value;
      if (!paperCode) return;

      fetch('/join/lookup?paper_code=' + encodeURIComponent(paperCode) + '&id=' + encodeURIComponent(conferenceId))
        .then(function (res) { return res.json().then(function (data) { return { status: res.status, data: data }; }); })
        .then(function (result) {
          if (!result.data.ok) {
            Swal.fire({ icon: 'error', title: 'Paper Not Found', text: result.data.message || 'Invalid Paper Code. Please try again.' });
            return;
          }
          const d = result.data;
          Swal.fire({
            icon: 'question',
            title: 'Are you sure?',
            html:
              'Are you sure you want to join the following submission as a Co-Author?<br><br>' +
              '<b>Paper Title:</b> ' + escapeHtmlForAlert(d.title) + '<br><br>' +
              '<b>Primary Author:</b> ' + escapeHtmlForAlert(d.primaryAuthorName) + ' (' + escapeHtmlForAlert(d.primaryAuthorEmail) + ')',
            showCancelButton: true,
            confirmButtonText: 'Yes',
            cancelButtonText: 'Cancel',
          }).then(function (confirmResult) {
            if (confirmResult.isConfirmed) {
              form.submit();
            }
          });
        })
        .catch(function () {
          Swal.fire({ icon: 'error', title: 'Something went wrong', text: 'Could not look up this paper code. Please try again.' });
        });
    });

    // SweetAlert's `html` option renders raw HTML - escape the server-
    // supplied title/name/email before interpolating them into it, so a
    // paper titled e.g. "<img src=x onerror=alert(1)>" can't execute
    // script in another co-author's browser.
    function escapeHtmlForAlert(value) {
      return String(value == null ? '' : value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }
  })();
</script>
        <div class="container px-5 my-5"></div>
        <script src="https://cdn.startbootstrap.com/sb-forms-latest.js"></script>

   
        <div class="modal fade" id="loadingModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content bg-transparent border-0 shadow-none">
      <div class="modal-body d-flex justify-content-center align-items-center">
        <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
          <span class="visually-hidden">Please wait...submitting data.</span>
        </div>
      </div>
    </div>
  </div>
</div>

</div>
    <%- include('partials/footer') %>
            <script src="/script.js"></script>

  </body>
</html>
