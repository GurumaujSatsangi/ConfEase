<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>DEI CMT</title>
    <link rel="shortcut icon" href="/dei_logo.png" type="image/x-icon">
    <link rel="stylesheet" href="/cmt.css" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css"
    />
    <script src="/cmt.js"></script>
    
    
    <link rel="stylesheet" href="/styles.css" />
    <link
      href="https://fonts.googleapis.com/css2?family=Google+Sans:wght@400;500;700&family=Roboto:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
    <script
      src="https://kit.fontawesome.com/a076d05399.js"
      crossorigin="anonymous"
    ></script>
  </head>
  <body>
    <header>
      <div class="header-left">
        <button class="menu-btn">
          <i class="fas fa-bars"></i>
        </button>
        <div class="logo">
          <img src="/dei_logo.png" alt="DEI" />
        </div>
      </div>

      
    </header>

    <main>
      <div class="welcome-section">
        <div class="welcome-content">
          
          <div class="welcome-header">
            <h1>Welcome to DEI Conference Management Toolkit!</h1>
          </div>
        </div>
      </div>

<table class="table table-striped">
  <thead>
      
    <tr>
      <th scope="col">Paper Title</th>
      <th scope="col">Author</th>
      <th scope="col">Co-Author</th>
      <th scope="col">Review Score</th>
      <th scope="col">Review Remarks</th>
      <th scope="col">Panelist Score</th>
    </tr>
  </thead>
  <tbody>

   <form action="/mark-presentation-as-complete" method="POST">
    <input type="hidden" name="paper_id" value="<%= submission.id %>">
    
        <tr>
          <td><%= submission.title %></td>
          <td><%= submission.primary_author_formatted || submission.primary_author %></td>
          <td><%= submission.co_authors_formatted || submission.co_authors %></td>
          <td><%= score.mean_score %> / 5</td>
          <td><%= submission.remarks %></td>
          <td><input type="number" class="form-control" max="5" step="0.1" id="panelist_score" name="panelist_score" required></td>
          <td><input type="submit" class="btn btn-outline-success" value="Submit"></td>
        </tr>
     </form> 

  </tbody>
</table>

      <div class="text-center mt-4">
<a href="javascript:history.back()" class="btn btn-secondary">Back</a>      </div>
  
    </main>

    <script src="/script.js"></script>
    <footer
      class="footer bg-dark text-white text-center py-3"
      style="position: fixed; left: 0; bottom: 0; width: 100%; z-index: 1030"
    >
      Copyright Dayalbagh Educational Institute. All rights reserved.
      <br />Powered by DEI Multimedia Laboratory / Centre
    </footer>
  </body>
</html>
