<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>DEI CMT</title>
    <link rel="shortcut icon" href="/dei_logo.png" type="image/x-icon">
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <%- include('../partials/dashboard/header') %>
    <div class="container">
        <h4>Welcome, <%= user.name %> (<%=user.email %>)</h4>

      <h6>My Subject Areas</h6><hr>
      <% if (tracks && tracks.length > 0) { %>
        <table class="table table-bordered">
          <thead class="table-light">
            <tr>
              <th>Track</th>
              <th>Subject Area</th>
              <th>Conference Title</th>
            </tr>
          </thead>
          <tbody>
            <% tracks.forEach(function(track, i) {
              const prev = i > 0 ? tracks[i - 1] : null;
              const sameConf = prev && prev.conference_id === track.conference_id;
              const sameTrack = sameConf && prev.group_id === track.group_id;
              const confSpan = tracks.filter(function(x) { return x.conference_id === track.conference_id; }).length;
              const trackSpan = tracks.filter(function(x) { return x.conference_id === track.conference_id && x.group_id === track.group_id; }).length;
            %>
            <tr>
              <% if (!sameTrack) { %>
                <td rowspan="<%= trackSpan %>"><%= track.track_group_name || '—' %></td>
              <% } %>
              <td><%= track.track_name %></td>
              <% if (!sameConf) { %>
                <td rowspan="<%= confSpan %>"><%= track.conference ? track.conference.title : '' %></td>
              <% } %>
            </tr>
            <% }); %>
          </tbody>
        </table>
      <% } else { %>
        <h6 class="text-muted">No subject areas have been assigned to you.</h6>
      <% } %>

      <h6>Review Submissions</h6>
      <% // helper to find track name by id %>
      <% const getTrackName = (id) => {
           const t = (tracks || []).find(tr => tr.track_id === id);
           return t ? t.track_name : 'Unknown Subject Area';
         } %>
      <% if (userSubmissions && userSubmissions.length > 0) { %>
        <div class="table-responsive">
          <table class="table table-bordered">
            <thead class="table-light">
              <tr>
                <th>Paper Title</th>
                <th>Subject Area</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% userSubmissions.forEach(function(submission) { %>
                <tr>
                  <td><%= submission.title %></td>
                  <td><%= getTrackName(submission.track_id) %></td>
                  <td>
                    <% if (submission.submission_status == 'DESK ACCEPT') { %>
                      <a type="button" class="btn btn-success" href="/reviewer/dashboard/review/<%= submission.paper_code %>">
                        <i class="bi bi-box-arrow-in-right"></i> &nbsp; Start Review
                      </a>
                    <% } else { %>
                      <b><i class="bi bi-check-circle-fill"></i> REVIEWED</b>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <h6>No Submissions Found</h6>
      <% } %>

      <hr>
      <h6>Revised Submissions</h6>
      <% if (revisedSubmissions && revisedSubmissions.length > 0) { %>
        <div class="table-responsive">
          <table class="table table-bordered">
            <thead class="table-light">
              <tr>
                <th>Paper Title</th>
                <th>Subject Area</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% revisedSubmissions.forEach(function(submission) { %>
                <tr>
                  <td><%= submission.title %></td>
                  <td><%= getTrackName(submission.track_id) %></td>
                  <td>
                    <a type="button" class="btn btn-info" href="/reviewer/dashboard/re-review/<%= submission.paper_code %>">
                      <i class="bi bi-box-arrow-in-right"></i> &nbsp; Review Revised Paper
                    </a>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <p class="text-muted">No revised submissions at this time.</p>
      <% } %>
    </div>
    <script src="/script.js"></script>
    <%- include('../partials/footer') %>
  </body>
</html>
