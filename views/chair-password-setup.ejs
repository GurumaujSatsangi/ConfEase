<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles.css">
    <title>DEI CMT</title>
    <link rel="shortcut icon" href="/dei_logo.png" type="image/x-icon">
</head>
<body>
    <%- include('partials/header') %>
    <div class="container">
        <% if (message) { %>
            <div class="alert alert-info" role="alert"><%= message %></div>
        <% } %>
        <div class="card" style="max-width: 480px;">
            <div class="card-header">
                <b>Set Your Chair Account Password</b>
            </div>
            <div class="card-body">
                <form action="/chair-password-setup" method="POST">
                    <input type="hidden" name="token" value="<%= token %>">
                    <div class="mb-3">
                        <label for="chairSetupPassword" class="form-label">New Password</label>
                        <div class="input-group">
                            <input type="password" class="form-control" placeholder="Enter new password" name="password" id="chairSetupPassword" required>
                            <button type="button" class="btn btn-outline-secondary" aria-label="Show password" onclick="togglePasswordVisibility('chairSetupPassword', this)">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary">Set Password</button>
                </form>
            </div>
        </div>
    </div>
    <%- include('partials/footer') %>
</body>
</html>
