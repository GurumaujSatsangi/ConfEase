<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>DEI CMT</title>
    <link rel="shortcut icon" href="/dei_logo.png" type="image/x-icon">

    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <!-- MDB -->

    <%- include('partials/dashboard/header') %>

    <div class="container">
      
      <h6>
        Submit Paper / Poster for
        <b
          ><%= conferences.title %>
          <p>Primary Author: <%=user.name %></p></b
        >
      </h6>
      <hr />
      <form action="/submit" method="POST" enctype="multipart/form-data">
        <div class="form-group">
          <input
            type="text"
            readonly
            hidden
            value="<%=conferences.conference_id %>"
            name="id"
            class="form-control"
            id="exampleInputEmail1"
            aria-describedby="emailHelp"
            placeholder=""
          />
        </div>
        <div class="form-group">
          <label for="exampleInputEmail1">Title</label>
          <input
            type="text"
            class="form-control"
            required
            name="title"
            id="exampleInputEmail1"
            aria-describedby="emailHelp"
            placeholder=""
          />
        </div>
        <br />
        <div class="form-group">
          <label for="exampleFormControlTextarea1">Abstract</label>
          <textarea
            class="form-control"
            required
            name="abstract"
            id="exampleFormControlTextarea1"
            rows="3"
          ></textarea>
        </div>
        <br />
        <div class="form-group">
          <label for="exampleFormControlSelect1">Area</label>
          <select
            class="form-control"
            required
            name="areas"
            id="exampleFormControlSelect1"
          >
            <% if (tracks && tracks.length > 0) { %> <%
            tracks.forEach(function(track) { %>
            <option value="<%= track.track_id %>">
              <%= track.group_name ? track.group_name + ': ' + track.track_name : track.track_name %>
            </option>
            <% }); %> <% } else { %>
            <option disabled>No subject areas available</option>
            <% } %>
          </select>
        </div>
        <br />
        <div class="form-group">
          <label for="exampleFormControlFile1">Upload Paper </label>
          <input type="file" required class="form-control" name="file" />
          <small class="form-text text-muted">Maximum file size: 4MB</small>
         <br> <small class="form-text text-muted">(Download <a href="/IEEE_TEMPLATE.doc">IEEE<i class="bi bi-file-earmark-arrow-down-fill"></i></a> / <a href="/SPRINGER_TEMPLATE.docx">Springer<i class="bi bi-file-earmark-arrow-down-fill"></i></a> Template)</small>

        </div>
        <br />
        <input type="submit" class="btn btn-outline-primary" value="Submit" />
      </form>
      <div class="container px-5 my-5"></div>
      <script src="https://cdn.startbootstrap.com/sb-forms-latest.js"></script>
    </div>

    <!-- Spinner Modal -->
    <div
      class="modal fade"
      id="loadingModal"
      tabindex="-1"
      aria-hidden="true"
      data-bs-backdrop="static"
      data-bs-keyboard="false"
    >
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-transparent border-0 shadow-none">
          <div
            class="modal-body d-flex justify-content-center align-items-center"
          >
            <div
              class="spinner-border text-primary"
              style="width: 3rem; height: 3rem"
              role="status"
            >
              <span class="visually-hidden"
                >Please wait...submitting data.</span
              >
            </div>
          </div>
        </div>
      </div>
    </div>

    <script src="/script.js"></script>
    <%- include('partials/footer') %>
    <script>
      (function () {
        const CLOSE_DELAY_SECONDS = 15;
        let remaining = CLOSE_DELAY_SECONDS;

        Swal.fire({
          title: "Important Instructions",
          html:
            '<ol style="text-align: justify;">' +
            '<li>Certain tracks may be specifically designated for Undergraduate and School students. Authors are requested to carefully review the available tracks and select the appropriate one during submission. For school students, if parents are submitting the paper on their behalf, it is recommended that the account be created using the student\'s name. For any queries or clarification, please contact the Conference Chairs.</li>' +
            '<li>The Conference Chairs reserve the right to change the track assigned to any submission, if deemed necessary. Authors will be notified via email if any changes are made to the track of their submission.</li>' +
            '<li>Authors may request or make changes to the selected track until the Full Paper Submission Deadline. Once the deadline has passed, no further changes to the track will be permitted. Authors are therefore advised to review their track selection carefully before submitting their papers.</li>' +
            '</ol>',
          icon: "info",
          confirmButtonText: `Close (${remaining})`,
          showConfirmButton: true,
          allowOutsideClick: false,
          allowEscapeKey: false,
          didOpen: () => {
            Swal.getConfirmButton().disabled = true;
            const timer = setInterval(() => {
              remaining -= 1;
              const btn = Swal.getConfirmButton();
              if (!btn) {
                clearInterval(timer);
                return;
              }
              if (remaining <= 0) {
                btn.disabled = false;
                btn.textContent = "Close";
                clearInterval(timer);
              } else {
                btn.textContent = `Close (${remaining})`;
              }
            }, 1000);
          },
        });
      })();
    </script>
  </body>
</html>
