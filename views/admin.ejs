<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles.css">
    <title>DEI CMT | Admin's Dashboard</title>
    <link rel="shortcut icon" href="/dei_logo.png" type="image/x-icon">
</head>
<body>
    <%- include('partials/dashboard/header') %>

    <div class="container">

        <h4>Admin Dashboard</h4><hr>

        <div class="accordion" id="accordionExample">
  <div class="accordion-item">
    <h2 class="accordion-header">
      <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="false" aria-controls="collapseOne">
        <strong>Manage Chairs</strong>
      </button>
    </h2>
    <div id="collapseOne" class="accordion-collapse collapse" data-bs-parent="#accordionExample">
      <div class="accordion-body">

        <h5>Create New Chair Credentials</h5><hr>

          <form action="/create-chair-credentials" method="post">

        <input class="form-control" type="text" name="name" placeholder="Name"><br>
        <input class="form-control" type="email" name="email" placeholder="Email ID"><br>
        <input class="form-control" type="text" name="contact_number" placeholder="Contact Number"><br>
        <input class="form-control" type="text" name="faculty" placeholder="Faculty"><br>
        <input class="form-control" type="text" name="department" placeholder="Department"><br>
        <input class="btn btn-primary" type="submit" value="Create Chair Credentials"><br>
        <p class="small">(An auto-generated password will be sent to the user)</p>

        

    </form><hr>

    <h5>Existing Chairs</h5><hr>

    <% if(chairs && chairs.length>0) { %>

        <table class="table">
        <tr>
            <th>
                Name
            </th>
            <th>Email ID</th>
            <th>Contact Number</th>
            <th>Faculty</th>
            <th>Department</th>
            <th>Action</th>
        </tr>
        <% chairs.forEach(function(chairs){ %>

<tr>
    <td>
        <%= chairs.name %>
    </td>
    <td>
        <%= chairs.email %>
    </td>
    <td>
        <%= chairs.contact_number %>
    </td>
    <td>
        <%= chairs.faculty %>
    </td>
    <td>
        <%= chairs.department %>
    </td>
    <td>
        <form method="post" action="/delete-account/<%= encodeURIComponent(chairs.email) %>" class="d-inline"><button type="submit" class="btn btn-danger">Delete Account</button></form><% if(chairs.status=="ACCESS REVOKED"){ %>
          <form method="post" action="/grant-access/<%= encodeURIComponent(chairs.email) %>" class="d-inline"><button type="submit" class="btn btn-success">Re-Grant Access</button></form> <% } else { %>
          <form method="post" action="/revoke-access/<%= encodeURIComponent(chairs.email) %>" class="d-inline"><button type="submit" class="btn btn-warning">Revoke Access</button></form>
          <form method="post" action="/reset-chair-password/<%= encodeURIComponent(chairs.email) %>" class="d-inline"><button type="submit" class="btn btn-secondary">Reset Password</button></form>
          <% } %>
    </td>

</tr>
        
        
        <% }) %>

            </table>

    
    <% } else { %>

        <p class="small">No Chairs Found!</p>

        <% } %>



      </div>
    </div>
  </div>
  <div class="accordion-item">
    <h2 class="accordion-header">
      <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
        <strong>Manage Conferences</strong>
      </button>
    </h2>
    <div id="collapseTwo" class="accordion-collapse collapse" data-bs-parent="#accordionExample">
      <div class="accordion-body">

        <% if(conferences && conferences.length>0) { %>

            <table class="table">
                <tr>
                    <th>Title</th>
                    <th>Created By</th>
                    <th>Action</th>
                </tr>

            <% conferences.forEach(function(conferences){ %>

            <tr>
                <td><%= conferences.title%></td>
                <td><%= conferences.created_by %></td>
                <td>
                  <a href="" class="btn btn-danger btn-sm">Terminate Conference</a>
                  <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#coAuthorRequestsModal-<%= conferences.conference_id %>">
                    Manage Co-Author Requests
                  </button>
                </td>
            </tr>

            <% }) %>
            </table>
        <% } else { %>

            <p class="small">No Conferences Found!</p>


            <% } %>



      </div>
    </div>
  </div>

  <% (conferences || []).forEach(function(conf) {
       const submissionsWithRequests = (coAuthorRequestsByConference && coAuthorRequestsByConference[conf.conference_id]) || [];
  %>
  <div class="modal fade" id="coAuthorRequestsModal-<%= conf.conference_id %>" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Co-Author Requests - <%= conf.title %></h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <% if (submissionsWithRequests.length > 0) { %>
            <% submissionsWithRequests.forEach(function(sub) { %>
              <p class="mb-1">
                <b>Paper ID:</b> <%= sub.paperId %><br>
                <b>Title:</b> <%= sub.title %><br>
                <b>Primary Author:</b> <%= sub.primary_author %>
              </p>
              <ul>
                <% sub.requests.forEach(function(r) { %>
                  <li class="mb-2">
                    <%= r.co_author %> (<%= r.status %>)
                    <% if (r.status === 'Pending') { %>
                      <div class="d-inline-flex gap-1 ms-2">
                        <form method="post" action="/admin/co-author-requests/accept/<%= r.request_id %>" class="d-inline">
                          <button type="submit" class="btn btn-success btn-sm">Approve Request</button>
                        </form>
                        <form method="post" action="/admin/co-author-requests/send-reminder/<%= sub.submission_id %>" class="d-inline">
                          <button type="submit" class="btn btn-outline-secondary btn-sm">Send Email Alert</button>
                        </form>
                        <form method="post" action="/admin/co-author-requests/reject/<%= r.request_id %>" class="d-inline">
                          <button type="submit" class="btn btn-danger btn-sm">Reject</button>
                        </form>
                      </div>
                    <% } else if (r.status === 'Accepted') { %>
                      <div class="d-inline-flex ms-2">
                        <form method="post" action="/admin/co-author-requests/remove/<%= sub.submission_id %>/<%= encodeURIComponent(r.co_author) %>" class="d-inline confirm-delete-form"
                          data-confirm-title="Remove this co-author?"
                          data-confirm-text="This action cannot be undone.">
                          <button type="submit" class="btn btn-warning btn-sm">Remove Co-Author</button>
                        </form>
                      </div>
                    <% } %>
                  </li>
                <% }) %>
              </ul>
              <hr>
            <% }) %>
          <% } else { %>
            <p class="small">No co-author requests for this conference.</p>
          <% } %>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
  </div>
  <% }) %>

  <div class="accordion-item">
    <h2 class="accordion-header">
      <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseUsers" aria-expanded="false" aria-controls="collapseUsers">
        <strong>Manage Users</strong>
      </button>
    </h2>
    <div id="collapseUsers" class="accordion-collapse collapse" data-bs-parent="#accordionExample">
      <div class="accordion-body">

        <h5>Create New User</h5><hr>

        <form action="/admin/users/create" method="post">

          <input class="form-control" type="text" name="name" placeholder="Name" required><br>
          <input class="form-control" type="email" name="email" placeholder="Email ID" required><br>
          <input class="form-control" type="text" name="contact_number" placeholder="Contact Number"><br>
          <input class="form-control" type="text" name="affiliation" placeholder="Affiliation"><br>
          <input class="btn btn-primary" type="submit" value="Create User"><br>
          <p class="small">(An auto-generated password will be sent to the user)</p>

        </form><hr>

        <h5>Existing Users</h5><hr>

        <% if (users && users.length > 0) { %>

          <div class="form-group mb-3">
            <input type="text" id="userSearchInput" class="form-control" placeholder="Search by name or email ID...">
          </div>

          <div class="table-responsive">
          <table class="table">
            <tr>
              <th style="min-width:150px;">Name</th>
              <th>Email ID</th>
              <th style="min-width:140px;">Contact Number</th>
              <th style="min-width:160px;">Affiliation</th>
              <th>Status</th>
              <th style="min-width:200px;">Action</th>
            </tr>
            <% users.forEach(function(u, idx){ %>

            <form id="updateForm-<%= idx %>" method="post" action="/admin/users/update/<%= encodeURIComponent(u.email) %>"></form>
            <form id="profileUpdateForm-<%= idx %>" method="post" action="/admin/users/request-profile-update/<%= encodeURIComponent(u.email) %>">
              <input type="hidden" name="remarks" id="profileUpdateRemarks-<%= idx %>">
            </form>

            <tr class="user-row" data-name="<%= (u.name || '').toLowerCase() %>" data-email="<%= (u.email || '').toLowerCase() %>">
              <td><input type="text" form="updateForm-<%= idx %>" name="name" class="form-control form-control-sm" value="<%= u.name || '' %>" required></td>
              <td><%= u.email %></td>
              <td><input type="text" form="updateForm-<%= idx %>" name="contact_number" class="form-control form-control-sm" value="<%= u.contact_number || '' %>"></td>
              <td><input type="text" form="updateForm-<%= idx %>" name="affiliation" class="form-control form-control-sm" value="<%= u.affiliation || '' %>"></td>
              <td><%= u.status || '—' %></td>
              <td>
                <div class="d-flex flex-column gap-1">
                  <button type="submit" form="updateForm-<%= idx %>" class="btn btn-success btn-sm w-100">Save</button>

                  <form method="post" action="/admin/users/reset-password/<%= encodeURIComponent(u.email) %>">
                    <button type="submit" class="btn btn-secondary btn-sm w-100">Reset Password</button>
                  </form>

                  <button type="button" class="btn btn-outline-warning btn-sm w-100" onclick="requestProfileUpdate(<%= idx %>, '<%= u.email.replace(/'/g, "\\'") %>')">Profile Update Required</button>

                  <form method="post" action="/admin/users/delete/<%= encodeURIComponent(u.email) %>" class="confirm-delete-form"
                    data-confirm-title="Delete this user?"
                    data-confirm-text="This action cannot be undone.">
                    <button type="submit" class="btn btn-danger btn-sm w-100">Delete User</button>
                  </form>
                </div>
              </td>
            </tr>

            <% }) %>
          </table>
          </div>

        <% } else { %>

          <p class="small">No Users Found!</p>

          <% } %>

      </div>
    </div>
  </div>

  <div class="accordion-item">
    <h2 class="accordion-header">
      <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseCanva" aria-expanded="false" aria-controls="collapseCanva">
        <strong>Canva Integration (Certificates)</strong>
      </button>
    </h2>
    <div id="collapseCanva" class="accordion-collapse collapse" data-bs-parent="#accordionExample">
      <div class="accordion-body">
        <p class="small">Certificates are generated in bulk via Canva's Autofill API against the configured Brand Template. This is a one-time, app-wide connection - any Chair's "Enable PDF Download" uses it once it's set up here.</p>
        <% if (canvaConnection) { %>
          <p class="text-success"><i class="bi bi-check-circle-fill"></i> Connected by <%= canvaConnection.connected_by %> on <%= new Date(canvaConnection.connected_at).toLocaleString() %>.</p>
          <form method="post" action="/admin/canva/disconnect" class="d-inline" onsubmit="return confirm('Disconnect Canva? Bulk certificate generation will stop working until it is reconnected.');">
            <button type="submit" class="btn btn-warning btn-sm">Disconnect Canva</button>
          </form>
        <% } else { %>
          <p class="text-danger"><i class="bi bi-x-circle-fill"></i> Not connected.</p>
          <a href="/admin/canva/connect" class="btn btn-primary btn-sm">Connect Canva</a>
        <% } %>
      </div>
    </div>
  </div>

<hr>

 

  

  <!-- <div class="accordion-item">
    <h2 class="accordion-header">
      <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
        Accordion Item #3
      </button>
    </h2>
    <div id="collapseThree" class="accordion-collapse collapse" data-bs-parent="#accordionExample">
      <div class="accordion-body">
        <strong>This is the third item’s accordion body.</strong> It is hidden by default, until the collapse plugin adds the appropriate classes that we use to style each element. These classes control the overall appearance, as well as the showing and hiding via CSS transitions. You can modify any of this with custom CSS or overriding our default variables. It’s also worth noting that just about any HTML can go within the <code>.accordion-body</code>, though the transition does limit overflow.
      </div>
    </div>
  </div> -->
</div>




    </div>

    <%- include('partials/footer') %>

    <script>
      document.addEventListener('DOMContentLoaded', function () {
        const searchInput = document.getElementById('userSearchInput');
        if (!searchInput) return;
        const rows = document.querySelectorAll('.user-row');
        searchInput.addEventListener('input', function () {
          const term = searchInput.value.trim().toLowerCase();
          rows.forEach(function (row) {
            const matches = !term || row.dataset.name.includes(term) || row.dataset.email.includes(term);
            row.style.display = matches ? '' : 'none';
          });
        });
      });

      function requestProfileUpdate(idx, email) {
        Swal.fire({
          icon: 'warning',
          title: 'Profile Update Required',
          text: 'This will email ' + email + ' asking them to update their profile.',
          input: 'textarea',
          inputLabel: 'Remarks (included in the email)',
          inputPlaceholder: 'e.g. Please update your affiliation to your current institution.',
          showCancelButton: true,
          confirmButtonText: 'Send Email',
          inputValidator: function (value) {
            return !value ? 'Please enter remarks before sending.' : undefined;
          }
        }).then(function (result) {
          if (result.isConfirmed) {
            document.getElementById('profileUpdateRemarks-' + idx).value = result.value;
            document.getElementById('profileUpdateForm-' + idx).submit();
          }
        });
      }
    </script>
</body>
</html>