<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DEI CMT</title>
    <link rel="stylesheet" href="/styles.css">
    <link rel="shortcut icon" href="/dei_logo.png" type="image/x-icon">
</head>
<body>
    <%- include('partials/dashboard/header') %>

    <div class="container">

        <h4><%= conference.title %></h4>

      <p class="small"><%- sanitizeDescription(conference.description) %></p>

      <% if (conference.cfp_link) { %>
        <p class="small"><a href="<%= conference.cfp_link %>" target="_blank" class="btn btn-primary btn-sm" rel="noopener">Call for Papers&nbsp; <i class="bi bi-box-arrow-up-right"></i></a></p>
      <% } %>

        <%
          // Driven by a live conference_roles read (passed in as liveRoles),
          // not the JWT's cached roles claim - a revoked role (or one
          // granted since this token was issued) is reflected immediately,
          // instead of leaving the user with neither their old role's
          // buttons nor the default-author "Create New Submission" UI.
          let roleStr = (Array.isArray(liveRoles) && liveRoles.length > 0)
            ? JSON.stringify(liveRoles).toLowerCase()
            : "";
        %>

        <% if(!roleStr){ %>

             <div class="btn-group" role="group">
    <button type="button" class="btn btn-primary btn-sm dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
      Create New Submission
    </button>
    <ul class="dropdown-menu">
      <li><a class="dropdown-item" href="/submission/primary-author/<%= conference.conference_id %>">Submit a Paper as Primary Author</a></li>
      <li><a class="dropdown-item" href="/submission/co-author/<%= conference.conference_id %>">Join a Paper as Co-Author</a></li>
    </ul>
     

   </div>
        
   <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#MySubmissions">
  My Submissions
</button>
        
        <% } %>
        
        <% if(roleStr && roleStr.includes('reviewer')) { %>

          
                    <a target="_blank" href="/reviewer/dashboard" class="btn btn-warning btn-sm">
  Review Submissions
                    </a>
             

    

<% } %>

<% if(isInvitee) { %>

    <a href="/submission/invited-talk/<%= conference.conference_id %>" type="button" class="btn btn-primary btn-sm">
  Submit Invited Talk Paper
    </a>

    <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#MySubmissions2">
  My Invited Talk Submissions
</button>

    <% } %>
    
    <% if(roleStr && roleStr.includes('poster_presentation_coordinator')){%>

        <a href="/score-posters/<%= conference.conference_id %>" type="button" class="btn btn-primary btn-sm">
  Start Poster Presentations
</a>





        <% } %>
        
        <% if(roleStr && roleStr.includes('session_chair')){ %>


        <a href="/panelist/active-session/<%=conference.conference_id%>" type="button" class="btn btn-primary btn-sm" >
  Start Oral Presentation
</a>
        
        <% }%>

          <% if(roleStr && roleStr.includes('meta_reviewer')){ %>


        <a target="_blank" href="/meta-reviewer/dashboard/<%= conference.conference_id %>" class="btn btn-primary btn-sm">
  Meta-Reviewer Dashboard
        </a>
        
        <% }%>

        <button type="button" class="btn btn-warning btn-sm" data-bs-container="body" data-bs-toggle="popover" data-bs-placement="right" data-bs-content="Can't see a specific role you were expecting? Kindly logout and re-login. If the issue still persists, please contact the conference chairs."><i class="bi bi-info-circle"></i>
</button>

<% if(isInvitee) { %>
<div class="modal fade" id="MySubmissions2" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-xl">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title fs-5" id="exampleModalLabel">My Invited Talk Submissions</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">

        <% if(invited_talk_submissions && invited_talk_submissions.length>0) { %>
            <table class="table">
            <tr>
                <th>Submission Title</th>
                <th>View Paper</th>
                <th>Action</th>
            </tr>

            <% invited_talk_submissions.forEach(function(submission){ %>

                <tr>
                    <td><%= submission.title %></td>
                    <td><a class="btn btn-primary btn-sm" target="_blank" href="<%= submission.file_url %>">View</a></td>
                    <td>

                        <p class="small"><li><a href="/submission/edit/primary-author/<%= submission.submission_id %>">Edit Submission</a>
                    </li><li><form method="POST" action="/submission/delete/invitee/<%= submission.paper_id %>" class="m-0"><button type="submit" class="btn btn-link p-0 border-0 align-baseline">Delete Submission</button></form></li>


            </p></td>
                </tr>

            <%}) %>

                    </table>


        <% } else { %>

            <p class="small">You have not made any submissions.</p>

            <% } %>


      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>
<% } %>


<div class="modal fade" id="MySubmissions" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-xl">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title fs-5" id="exampleModalLabel">My Submissions</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">

        <% if(submissions && submissions.length>0) { %>
            <table class="table">
            <tr>
                <th>Paper ID</th>
                <th>Submission Title</th>
                <th>View Paper</th>
                <th>Paper Code</th>
                <th>Co-Authors / Primary Author</th>
                <th>Status</th>
                <th>Action</th>
            </tr>

            <% submissions.forEach(function(submission){ %>

                <tr>
                    <td><%= submission.paper_number != null ? String(submission.paper_number).padStart(4, '0') : '—' %></td>
                    <td><%= submission.title %></td>
                    <td><a class="btn btn-primary btn-sm" target="_blank" href="<%= submission.file_url %>">View</a></td>
                    <td><button type="button" class="btn btn-primary btn-sm" data-bs-container="body" data-bs-toggle="popover" data-bs-placement="top" data-bs-content="<%= submission.paper_code %>">View</button></td>
                    <td>
                        <% if (submission.isPrimaryAuthor) { %>
                            <% if (submission.co_authors && submission.co_authors.length > 0) { %>
                                <button type="button" class="btn btn-primary btn-sm" data-bs-container="body" data-bs-toggle="popover" data-bs-placement="top" data-bs-content="<%= submission.co_authors %>">View</button>
                            <% } else { %>
                                <p class="small">None</p>
                            <% } %>
                        <% } else { %>
                            <%= submission.primary_author %>
                        <% } %>
                    </td>

                    <td>
                        <%= submission.submission_status %>
                        <% if (submission.submission_status === 'Revision Required' && submission.isPrimaryAuthor) { %>
                            <br><a href="/submission/revised/primary-author/<%= submission.submission_id %>">Submit Revised Paper</a>
                        <% } else if ((submission.submission_status === 'Accepted for Oral Presentation' || submission.submission_status === 'Accepted for Poster Presentation') && submission.isPrimaryAuthor) { %>
                            <br><a href="/submission/final-camera-ready/primary-author/<%= submission.submission_id %>">Submit Final Camera Ready Paper</a>
                        <% } else if (submission.submission_status === 'Submitted Final Camera Ready Paper for Oral Presentation' || submission.submission_status === 'Submitted Final Camera Ready Paper for Poster Presentation') { %>
                            <br><strong><%= submission.scheduleText %></strong>
                        <% } %>
                    </td>
                    <% if (submission.submission_status === 'Submitted Final Camera Ready Paper for Oral Presentation' || submission.submission_status === 'Submitted Final Camera Ready Paper for Poster Presentation') { %>
                    <td>
                        <% if (submission.registration) { %>
                            <button type="button" class="btn btn-success btn-sm" disabled>Registered</button>

                        <% if (submission.submission_status === 'Submitted Final Camera Ready Paper for Poster Presentation' && submission.registration.mode_of_presentation === 'Online' && posterSchedule && posterSchedule.vc_link) { %>

                      <p class="small mb-1"><strong>Link for Online Attendees:</strong> <a href="<%= posterSchedule.vc_link %>" target="_blank" rel="noopener">Join</a></p>

                      <% } %>
                            <div class="accordion mt-2" id="registrationAccordion-<%= submission.submission_id %>">
                              <div class="accordion-item">
                                <h2 class="accordion-header">
                                  <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#registrationDetails-<%= submission.submission_id %>">
                                    View Registration Details
                                  </button>
                                </h2>
                                <div id="registrationDetails-<%= submission.submission_id %>" class="accordion-collapse collapse" data-bs-parent="#registrationAccordion-<%= submission.submission_id %>">
                                  <div class="accordion-body">
                                    <p class="mb-1"><strong>Mode of Presentation:</strong> <%= submission.registration.mode_of_presentation %></p>
                                    <p class="mb-1"><strong>Number of Authors attending Offline:</strong> <%= submission.registration.attending_offline %></p>
                                    <p class="mb-0"><strong>Link to Video:</strong> <a href="<%= submission.registration.link_to_video %>" target="_blank" rel="noopener"><%= submission.registration.link_to_video %></a></p>
                                  </div>
                                </div>
                              </div>
                            </div>
                        <% } else if (submission.isPrimaryAuthor) { %>
                            <a href="/submission/register/<%= submission.submission_id %>" class="btn btn-success btn-sm">Register</a>
                        <% } else { %>
                            <p class="small">Not yet registered. Only the primary author can register this submission.</p>
                        <% } %>
                    </td>
                    <% } else if (submission.submission_status === 'Poster Scored' || submission.submission_status === 'Presentation Completed') { %>
                    <td>
                        <% if (submission.certificateGenerated) { %>
                            <a href="/submission/download-certificate/<%= submission.submission_id %>" class="btn btn-success btn-sm">Download Certificate</a>
                        <% } else { %>
                            <p>Certificate Not Yet Generated</p>
                        <% } %>
                    </td>
                    <% } else { %>
                    <td>
                        <% if (submission.isPrimaryAuthor) { %>
                        <p class="small"><li><a href="/submission/edit/primary-author/<%= submission.submission_id %>">Edit Submission</a>
                    </li><li><form method="POST" action="/submission/delete/primary-author/<%= submission.submission_id %>" class="m-0"><button type="submit" class="btn btn-link p-0 border-0 align-baseline">Delete Submission</button></form></li>
                <li><a target="_blank" href="/submission/view-co-author-requests/<%= submission.submission_id %>">Co-Author Requests</a></li>

            </p>
                        <% } else { %>
                            <p class="small">None</p>
                        <% } %>
                    </td>
                    <% } %>
                </tr>
            
            <%}) %>

                    </table>

        
        <% } else { %>

            <p class="small">You have not made any submissions.</p>

            <% } %>

        
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>
  
        <hr>

        <h5>Important Dates</h5>
        <p class="small">(All timings are in IST)</p>
        <table class="table">
            
            <tr>
                <th>FULL PAPER SUBMISSION</th>
                <th>ACCEPTANCE NOTIFICATION</th>
                <th>FINAL CAMERA READY PAPER SUBMISSION</th>
                <th>REGISTRATION</th>
            </tr>
            <tr>
                <td><%= conference.full_paper_submission %> (11:59 PM)</td>
                <td><%= conference.acceptance_notification %></td>
                <td><%= conference.camera_ready_paper_submission %> (11:59 PM)</td>
                <td><%= conference.registration %> (11:59 PM)</td>
            </tr>
        </table>

        <h5>Subject Areas</h5>

        <% if(conference_tracks && conference_tracks.length>0){ %>
            <table class="table table-bordered">
              <thead class="table-light">
                <tr>
                  <th>Track</th>
                  <th>Subject Area</th>
                </tr>
              </thead>
              <tbody>
                <% conference_tracks.forEach(function(ct, i) {
                     const sameTrack = i > 0 && conference_tracks[i - 1].group_id === ct.group_id;
                     const trackSpan = conference_tracks.filter(function(x) { return x.group_id === ct.group_id; }).length;
                %>
                <tr>
                  <% if (!sameTrack) { %>
                    <td rowspan="<%= trackSpan %>"><%= ct.group_name || 'Conference level' %></td>
                  <% } %>
                  <td><%= ct.track_name %></td>
                </tr>
                <% }); %>
              </tbody>
            </table>
        <% } else { %>

            <p class="small">No subject areas have been added by the Chair! If you think this is an error, please contact the conference Chair.</p>

            <% } %>

    </div>
    
    <%- include('partials/footer') %>

    <script src="/script.js"></script>
</body>
</html>