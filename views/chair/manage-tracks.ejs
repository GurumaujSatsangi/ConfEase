<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles.css">
    <title>DEI CMT</title>
</head>
<body>
    <%-include('../partials/dashboard/header') %>
    <div class="container">
    <h4>Manage Tracks</h4>
    <h6>Conference: <%= conference.title %></h6>
    <hr>
    <h5>Tracks (optional)</h5>
    <p class="small text-muted">Tracks group subject areas, for example DSC2026 and NSC2026. Conferences without tracks keep their subject areas directly under the conference.</p>
    <form action="/chair/dashboard/create-group/<%= conference.conference_id %>" method="post" class="mb-3">
      <input class="form-control mb-2" type="text" name="group_name" placeholder="Track Name (for example DSC2026)" required>
      <input class="btn btn-success" type="submit" value="Add Track">
    </form>
    <% if (groups && groups.length > 0) { %>
    <table class="table table-bordered table-sm">
      <tr>
        <th>Track</th>
        <th>Subject Areas</th>
        <th>Action</th>
      </tr>
      <% groups.forEach(function(g) { %>
        <tr>
          <td>
            <form method="post" action="/chair/dashboard/update-group/<%= g.group_id %>" class="d-flex gap-2">
              <input class="form-control" type="text" name="group_name" value="<%= g.group_name %>" required>
              <button type="submit" class="btn btn-warning">Update</button>
            </form>
          </td>
          <td><%= tracks.filter(function(s) { return s.group_id === g.group_id; }).length %></td>
          <td>
            <form method="post" action="/chair/dashboard/delete-group/<%= g.group_id %>">
              <button type="submit" class="btn btn-danger">Delete</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </table>
    <% } else { %>
    <p>No tracks have been created for this conference. Subject areas are managed directly under the conference.</p>
    <% } %>

    <hr>
    <h5>Subject Areas</h5>

  
    <form action="/create-track/<%=conference.conference_id %>" method="post" class="form-control">
        <div class="mb-3">
        <label class="form-label">Track (optional)</label>
        <select class="form-select" name="group_id">
          <option value="">No track (directly under the conference)</option>
          <% (groups || []).forEach(function(g) { %>
          <option value="<%= g.group_id %>"><%= g.group_name %></option>
          <% }) %>
        </select></div>
        <div class="mb-3">

        <input class="form-control" type="text" name="track_title" placeholder="Subject Area Name"></div>
        <div class="mb-3">
<textarea class="form-control" name="reviewers" placeholder="Email IDs of the Reviewers"></textarea></div>

<div class="mb-3">
    <lable class="form-label">Session Date</lable>
            <input class="form-control" type="date" name="session_date" placeholder="Session Date">

</div>

<div class="mb-3">
        <lable class="form-label">Session Start Time</lable>

            <input class="form-control" type="time" name="session_start_time" placeholder="Session Start Time">

</div>

<div class="mb-3">
        <lable class="form-label">Session End Time</lable>

            <input class="form-control" type="time" name="session_end_time" placeholder="Session End Time">

</div>

<div class="mb-3">
<textarea class="form-control" name="session_chairs" placeholder="Email IDs of the Session Chairs"></textarea>

</div>



<div class="mb-3">
<input class="btn btn-success" type="submit" value="Add Subject Area"></div>
    </form>

  <hr>

       <% if (tracks && tracks.length > 0) { %>
  <table class="table table-bordered">
    <tr>
      <th>Track</th>
      <th>Subject Area</th>
      <th>Reviewers</th>
      <th colspan="3">Session Schedule</th>
      <th>Session Chair</th>
      <th>Action</th>
    </tr>

    <% tracks.forEach(function(track) { %>
      <tr>
        <form method="POST" action="/chair/dashboard/update-track/<%= track.track_id %>">
          <td><%= (groups.find(function(g) { return g.group_id === track.group_id; }) || { group_name: "Conference level" }).group_name %></td>

          <td>
            <input
              class="form-control"
              type="text"
              name="track_title"
              value="<%= track.track_name %>"
              required
            >
          </td>

          <td>
            <textarea
              class="form-control"
              name="reviewers"
              placeholder="Comma separated emails"
              required
            ><%= track.track_reviewers %></textarea><br>

            <p class="small">(DEI CMT follows Single-Blind Review Model. <a href="#" onclick="showSingleBlind()">Click Here</a> to Know More.)</p>          </td>

        

          <td>
            <input
              type="date"
              class="form-control"
              name="session_date"
              value="<%= track.presentation_date || '' %>"
              required
            >
          </td>

          <td>
            <input
              type="time"
              class="form-control"
              name="start_time"
              value="<%= track.presentation_start_time %>"
              required
            >
          </td>

          <td>
            <input
              type="time"
              class="form-control"
              name="end_time"
              value="<%= track.presentation_end_time %>"
              required
            >
          </td>

          <td>
            <textarea
              class="form-control"
              name="panelists"
              placeholder="Comma separated names"
              required
            ><%= track.panelists %></textarea>
          </td>

          <td>
            <button type="submit" class="btn btn-warning mb-1">
              Update
            </button>
            <br>
            <form method="post" action="/chair/dashboard/delete-track/<%= track.track_id %>" class="d-inline">
              <button type="submit" class="btn btn-danger">Delete</button>
            </form>
          </td>

        </form>
      </tr>
    <% }) %>
  </table>

<% } else { %>
  <h6>
    <i class="bi bi-emoji-frown-fill"></i>
    No subject areas have been created for this conference yet.
  </h6>
<% } %>

    </div>

    <%-include('../partials/footer') %>

</body>
<script src="/script.js"></script>
</html>