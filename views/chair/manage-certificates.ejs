<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DEI CMT</title>
    <link rel="stylesheet" href="/styles.css">
    <link rel="shortcut icon" href="/dei_logo.png" type="image/x-icon">
</head>
<body>
    <%- include('../partials/dashboard/header') %>

    <div class="container">
        <h4>Manage Certificates</h4>
        <h6><%= conference.title %></h6><hr>

        <% if (message) { %>
          <div class="alert alert-info"><%= message %></div>
        <% } %>

        <form method="POST" action="/chair/dashboard/enable-pdf-download/<%= conference.conference_id %>" class="d-inline">
          <button type="submit" class="btn btn-secondary btn-uniform">Enable PDF Download</button>
        </form>
        <p class="small text-muted">Generates (or fills in whatever's still missing for) author, reviewer, session chair, and invited speaker certificates for this conference. Author certificates are listed below.</p>

        <hr>

        <% if (certificates && certificates.length > 0) { %>
          <table class="table">
            <tr>
              <th>Paper ID</th>
              <th>Title</th>
              <th>Certificate Status</th>
              <th>Action</th>
            </tr>
            <% certificates.forEach(function(cert) { %>
              <tr>
                <td><%= cert.paperId %></td>
                <td><%= cert.title %></td>
                <td><%= cert.statusLabel %></td>
                <td>
                  <% if (cert.canRegenerate) { %>
                    <form method="POST" action="/chair/dashboard/regenerate-certificate/<%= cert.submissionId %>" class="d-inline">
                      <button type="submit" class="btn btn-warning btn-sm">Regenerate Certificate</button>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </table>
        <% } else { %>
          <p class="small">No submissions are eligible for a certificate yet (a submission becomes eligible once it's Poster Scored or Presentation Completed).</p>
        <% } %>
    </div>

    <%- include('../partials/footer') %>

    <script src="/script.js"></script>
</body>
</html>
