<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles.css">
    <title>DEI CMT | Pending Acceptance Notifications</title>
    <link rel="shortcut icon" href="/dei_logo.png" type="image/x-icon">
</head>
<body>

    <%- include('../partials/dashboard/header') %>

    <div class="container">

        <h4>Pending Acceptance Notification</h4>
        <h6>Acceptance Notification was not sent to the authors of the following submissions because the status of these submissions is either 'Submitted for Review' or 'Submitted Revised Paper'. These are waiting for the assigned Meta-Reviewer to record a recommendation; publish again once that is done.</h6>
        <hr>
<% if(pending_acceptance_notifications.length>0){ %>

        <ul>

        <% pending_acceptance_notifications.forEach(function(pending_acceptance_notifications){ %>


        <li>Submission ID: <%= pending_acceptance_notifications %></li>

        <% }) %>
    
        </ul>
    <% } %>


    </div>
    <%- include('../partials/footer') %>

    <script src="/script.js"></script>
</body>
</html>