<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>DEI CMT</title>

    <link rel="stylesheet" href="/styles.css" />
    <link rel="shortcut icon" href="/dei_logo.png" type="image/x-icon" />
  </head>
  <body>
    <%- include('../partials/dashboard/header') %>

    <div class="container">
      <h4>Registrations</h4>
      <h6>Conference: <%= conference.title %></h6>

      <% if (message) { %>
        <div class="alert alert-info"><%= message %></div>
      <% } %>

      <div class="row mb-4">
        <div class="col-md-4 mb-3">
          <div class="card text-center h-100">
            <div class="card-body">
              <h6 class="card-subtitle text-muted mb-2">Accepted Papers vs Final Camera Ready Submitted</h6>
              <p class="card-text fs-4 mb-0"><%= counts.accepted %> / <%= counts.fcrpSubmitted %></p>
            </div>
          </div>
        </div>
        <div class="col-md-4 mb-3">
          <div class="card text-center h-100">
            <div class="card-body">
              <h6 class="card-subtitle text-muted mb-2">Registrations vs Final Camera Ready Submitted</h6>
              <p class="card-text fs-4 mb-0"><%= counts.registered %> / <%= counts.fcrpSubmitted %></p>
            </div>
          </div>
        </div>
        <div class="col-md-4 mb-3">
          <div class="card text-center h-100">
            <div class="card-body">
              <h6 class="card-subtitle text-muted mb-2">Online vs Offline</h6>
              <p class="card-text fs-4 mb-0"><%= counts.online %> / <%= counts.offline %></p>
            </div>
          </div>
        </div>
      </div>

      <div class="row mb-3 align-items-end">
        <div class="col-md-4">
          <a href="/chair/dashboard/registrations/<%= conference.conference_id %>/export" class="btn btn-outline-success">
            <i class="bi bi-file-earmark-excel"></i> Export as Excel
          </a>
        </div>
        <div class="col-md-4 offset-md-4">
          <div class="form-group">
            <label for="registrationStatusFilter">Filter by Registration Status</label>
            <select id="registrationStatusFilter" class="form-control">
              <option value="">All</option>
              <option value="registered">Registered</option>
              <option value="not-registered">Not Registered</option>
            </select>
          </div>
        </div>
      </div>

      <hr>

      <% if (rows && rows.length > 0) { %>
        <div class="table-responsive">
          <style>
            .table-accordion .accordion-button { padding: 0.5rem 1rem; font-size: 0.9rem; }
            .table-accordion .accordion-body { padding: 0.75rem 1rem; font-size: 0.85rem; }
          </style>
          <table class="table table-bordered align-middle text-wrap" style="width:100%;">
            <thead class="table-light text-center">
              <tr>
                <th style="min-width:100px;">Paper ID</th>
                <th style="min-width:200px;">Title</th>
                <th style="min-width:200px;">Primary Author</th>
                <th style="min-width:200px;">Co-Authors</th>
                <th style="min-width:180px;">Submission Status</th>
                <th style="min-width:200px;">Registration Status</th>
              </tr>
            </thead>
            <tbody>
              <% rows.forEach(function(row) { %>
                <tr class="registration-row" data-registered="<%= row.registered ? 'registered' : 'not-registered' %>">
                  <td><%= row.paperId %></td>
                  <td><%= row.title %></td>
                  <td><%= row.primaryAuthor %></td>
                  <td><%= row.coAuthors %></td>
                  <td class="text-center">
                    <span class="badge bg-secondary"><%= row.submissionStatus %></span>
                  </td>
                  <td>
                    <% if (row.registered) { %>
                      <div class="text-center mb-2">
                        <span class="badge bg-success">Registered</span>
                      </div>
                      <div class="accordion accordion-flush table-accordion border" id="accordion-<%= row.submissionId %>">
                        <div class="accordion-item">
                          <h2 class="accordion-header" id="heading-<%= row.submissionId %>">
                            <button class="accordion-button collapsed bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-<%= row.submissionId %>" aria-expanded="false" aria-controls="collapse-<%= row.submissionId %>">
                              View Registration Details
                            </button>
                          </h2>
                          <div id="collapse-<%= row.submissionId %>" class="accordion-collapse collapse" aria-labelledby="heading-<%= row.submissionId %>" data-bs-parent="#accordion-<%= row.submissionId %>">
                            <div class="accordion-body bg-white">
                              <p class="mb-1"><strong>Mode of Presentation:</strong> <%= row.modeOfPresentation %></p>
                              <p class="mb-1"><strong>Number of Authors Attending Offline:</strong> <%= row.attendingOffline %></p>
                              <p class="mb-0"><strong>Link to Video:</strong> <a href="<%= row.linkToVideo %>" target="_blank" rel="noopener"><%= row.linkToVideo %></a></p>
                            </div>
                          </div>
                        </div>
                      </div>
                    <% } else { %>
                      <div class="text-center">
                        <span class="badge bg-warning text-dark">Not Registered</span>
                      </div>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <div id="noResultsMessage" class="text-center my-5" style="display: none;">
          <h5 class="text-muted"><i class="bi bi-search"></i> No rows match the selected filter.</h5>
        </div>
      <% } else { %>
        <div class="text-center my-5">
          <h5 class="text-muted"><i class="bi bi-emoji-frown-fill"></i> No Final Camera Ready Paper submissions found.</h5>
        </div>
      <% } %>
    </div>

    <script src="/script.js"></script>
    <%- include('../partials/footer') %>

    <script>
      document.addEventListener('DOMContentLoaded', function() {
        const registrationStatusFilter = document.getElementById('registrationStatusFilter');
        const rows = document.querySelectorAll('.registration-row');
        const noResultsMessage = document.getElementById('noResultsMessage');
        if (!registrationStatusFilter) return;

        function applyFilter() {
          const selected = registrationStatusFilter.value;
          let visibleCount = 0;
          rows.forEach(function(row) {
            const isVisible = !selected || row.getAttribute('data-registered') === selected;
            row.style.display = isVisible ? '' : 'none';
            if (isVisible) visibleCount++;
          });
          if (noResultsMessage) {
            noResultsMessage.style.display = (visibleCount === 0 && rows.length > 0) ? 'block' : 'none';
          }
        }

        registrationStatusFilter.addEventListener('change', applyFilter);
      });
    </script>
  </body>
</html>
