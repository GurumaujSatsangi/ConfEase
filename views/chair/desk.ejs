<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DEI CMT</title>
    <link rel="stylesheet" href="/styles.css">
    <link rel="shortcut icon" href="/dei_logo.png" type="image/x-icon">
</head>
<body>
    <%- include('../partials/dashboard/header') %>

    <div class="container">
        <h4>Desk Review</h4>
        <h6><%= conference.title %></h6>

        <% if(submissions && submissions.length>0) { %>
          <a href="/chair/dashboard/desk/download-all/<%= conference.conference_id %>" class="btn btn-outline-primary mb-2">
            <i class="bi bi-file-earmark-zip"></i> Download All Submissions (.zip)
          </a>
        <% } %>
        <hr>

        <% if(submissions && submissions.length>0) { %>


            <div class="table-responsive">
            <table class="table">
                <tr>
                    <th>PAPER ID</th>
                    <th>TITLE</th>
                    <th>ABSTRACT</th>
                    <th>VIEW PAPER</th>
                    <% if (drillbitConfigured) { %>
                    <th>AI / PLAGIARISM CHECK</th>
                    <% } %>
                    <th>DECISION</th>
                    <th>ACTION</th>
                </tr>
            <% submissions.forEach(function(submission){ %>

<form action="/submit-desk-decision/<%= submission.submission_id %>" method="post">
              <tr>
                <td><%= submission.paper_number != null ? String(submission.paper_number).padStart(4, '0') : '—' %></td>
                <td><%= submission.title %></td>
                <td><a class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#exampleModal1">Read</a></td>
                <td><a target="_blank" href="<%= submission.file_url %>" class="btn btn-primary btn-sm">View</a></td>
                <% if (drillbitConfigured) { %>
                <td>
                  <% if (!submission.drillbit) { %>
                    <span class="text-muted small">Not submitted</span>
                  <% } else if (submission.drillbit.status === 'pending') { %>
                    <span class="text-muted small"><i class="bi bi-hourglass-split"></i> Processing (usually 10-15 min)</span>
                  <% } else if (submission.drillbit.status === 'failed') { %>
                    <span class="text-danger small" title="<%= submission.drillbit.error_message || '' %>"><i class="bi bi-exclamation-circle"></i> Analysis failed</span>
                  <% } else { %>
                    <div class="small mb-1">Plagiarism: <strong><%= submission.drillbit.plagiarism_percent %>%</strong></div>
                    <% if (submission.drillbit.ai_percent != null) { %>
                      <div class="small mb-2">AI Content: <strong><%= submission.drillbit.ai_percent %>%</strong></div>
                    <% } %>
                    <% if (submission.drillbit.d_key) { %>
                      <a class="btn btn-outline-secondary btn-sm mb-1" target="_blank" href="/chair/dashboard/desk/drillbit-report/<%= submission.submission_id %>/similarity">Similarity Report</a><br>
                      <% if (submission.drillbit.ai_percent != null) { %>
                        <a class="btn btn-outline-secondary btn-sm" target="_blank" href="/chair/dashboard/desk/drillbit-report/<%= submission.submission_id %>/ai">AI Report</a>
                      <% } %>
                    <% } %>
                  <% } %>
                </td>
                <% } %>
                <td>

    <div class="form-check">
  <input class="form-check-input" value="DESK ACCEPT" type="radio" name="decision" id="radioDefault1">
  <label class="form-check-label" for="radioDefault1">
    ACCEPTED
  </label>
</div>
<div class="form-check">
  <input class="form-check-input" value="DESK REJECT" type="radio" name="decision" id="radioDefault2">
  <label class="form-check-label" for="radioDefault2">
    REJECTED
  </label>
</div>
                </td>
                <td>
                  <button type="submit" value="Save" class="btn btn-success btn-sm">Save</button>
                </td>
            </tr></form>

            <div class="modal fade" id="exampleModal1" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title fs-5" id="exampleModalLabel"><%= submission.title %></h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">

        <p class="small" align="justify">

            <%= submission.abstract %>

        </p>

    </div>
   
    </div>
  </div>
</div>
            
            <% }) %>
                    </table>
                    </div>

        <% } else { %>
<p class="small">No Submissions Found!</p>
            <% } %>

    </div>

    

    <%- include('../partials/footer') %>
  
    <script src="/script.js"></script>
</body>
</html>