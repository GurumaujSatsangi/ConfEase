<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>DEI CMT</title>

    <link rel="stylesheet" href="/styles.css" />
    <link rel="shortcut icon" href="/dei_logo.png" type="image/x-icon" />
  </head>
  <body>
    <%- include('../partials/dashboard/header') %>

    <div class="container">
        <h4>Manage Submissions</h4>
        <h6>Conference: <%=confdata.title%></h6>
        
        <form action="/publish/review-results" method="POST">
          <input type="hidden" name="conference_id" value="<%= confdata.conference_id %>" />
          <% 
            // Get current date in IST
            const now = new Date();
            const istOffset = 5.5 * 60 * 60 * 1000; // IST is UTC+5:30
            const istTime = new Date(now.getTime() + istOffset);
            const currentDateISO = istTime.toISOString().split("T")[0];
            
            // Parse DD-MM-YYYY format from confdata.acceptance_notification
            const [day, month, year] = confdata.acceptance_notification.split('-');
            const acceptanceDateISO = `${year}-${month}-${day}`;
            
            // Compare ISO date strings (YYYY-MM-DD format works correctly)
            const isNotificationDateReached = currentDateISO >= acceptanceDateISO;
          %>

          <% if (isNotificationDateReached) { %>
            <div class="alert alert-success mb-3">
              <i class="bi bi-check-circle"></i> Review results can now be published!
            </div>
            <input type="submit" class="btn btn-outline-danger" value="Publish Review Results" />
          <% } else { %>
            <button type="button" class="btn btn-outline-secondary" disabled 
                    title="Available from <%= confdata.acceptance_notification %>">
              <i class="bi bi-lock"></i> Publish Review Results (Available from <%= confdata.acceptance_notification %>)
            </button>
          <% } %>
        </form>
        <hr>

        <div class="row mb-4">
          <div class="col-md-4">
            <div class="form-group">
              <label for="searchInput">Search Submissions</label>
              <input 
                type="text" 
                id="searchInput" 
                class="form-control" 
                placeholder="Search by title, author, or paper code..."
              >
            </div>
          </div>
          <div class="col-md-4">
            <div class="form-group">
              <label for="trackFilter">Filter by Subject Area</label>
              <select id="trackFilter" class="form-control">
                <option value="">All Subject Areas</option>
                <% if (tracks && tracks.length > 0) { %>
                  <% tracks.forEach(function(track) { %>
                    <option value="<%= track.track_name %>"><%= track.track_name %></option>
                  <% }); %>
                <% } %>
              </select>
            </div>
          </div>
          <div class="col-md-4">
            <div class="form-group">
              <label for="statusFilter">Filter by Status</label>
              <select id="statusFilter" class="form-control">
                <option value="">All Statuses</option>
                <% if (uniqueStatuses && uniqueStatuses.length > 0) { %>
                  <% uniqueStatuses.forEach(function(status) { %>
                    <option value="<%= status %>"><%= status %></option>
                  <% }); %>
                <% } %>
              </select>
            </div>
          </div>
        </div>

        <div class="row mb-3">
          <div class="col-12">
            <span id="resultsCount" class="badge badge-info text-dark border">
              Showing <span id="visibleCount"><%= submissions ? submissions.length : 0 %></span> 
              of <span id="totalCount"><%= submissions ? submissions.length : 0 %></span> submissions
            </span>
            <button id="clearFilters" class="btn btn-sm btn-outline-secondary ms-2" style="display: none;">
              Clear Filters
            </button>
          </div>
        </div>

        <hr>
        
        <div id="submissionsContainer">
          <% if (submissions && submissions.length > 0) { %>
            <div class="table-responsive">
              <style>
                .cs-table td { vertical-align: top; padding: 12px; }
                /* Custom accordion styling for compact tables */
                .table-accordion .accordion-button { padding: 0.5rem 1rem; font-size: 0.9rem; }
                .table-accordion .accordion-body { padding: 0.75rem 1rem; font-size: 0.85rem; }

                /* Review journey tracker (parcel-delivery style) */
                .journey-track { display: flex; align-items: flex-start; overflow-x: auto; padding: 0.5rem 0 1rem; }
                .journey-step { flex: 1 0 110px; text-align: center; position: relative; padding: 0 4px; }
                .journey-step .journey-line { position: absolute; top: 17px; left: -50%; width: 100%; height: 3px; background: #e9ecef; z-index: 0; }
                .journey-step:first-child .journey-line { display: none; }
                .journey-step .journey-dot {
                  width: 34px; height: 34px; border-radius: 50%; margin: 0 auto 6px;
                  display: flex; align-items: center; justify-content: center; position: relative; z-index: 1;
                  background: #fff; color: #adb5bd; font-size: 1rem; border: 3px solid #e9ecef;
                }
                .journey-step .journey-label { font-size: 0.78rem; color: #495057; }
                .journey-step.pending .journey-label, .journey-step.skipped .journey-label { color: #adb5bd; }
                .journey-step.done .journey-dot { background: #198754; border-color: #198754; color: #fff; }
                .journey-step.done .journey-line { background: #198754; }
                .journey-step.current .journey-dot { background: #0d6efd; border-color: #0d6efd; color: #fff; }
                .journey-step.rejected .journey-dot { background: #dc3545; border-color: #dc3545; color: #fff; }
                .journey-step.rejected .journey-line { background: #dc3545; }
                .journey-step.skipped .journey-dot { background: #f8f9fa; border-color: #f1f1f1; color: #ced4da; }
              </style>

              <table class="table table-bordered align-middle text-wrap cs-table" style="width:100%;">
                <thead class="table-light text-center">
                  <tr>
                    <th style="min-width:100px;">Paper ID</th>
                    <th style="min-width:180px;">Subject Area</th>
                    <th style="min-width:200px;">Primary Author</th>
                    <th style="min-width:200px;">Co-Authors</th>
                    <th style="min-width:120px;">Status</th>
                    <th style="min-width:160px;">Review Details</th>
                    <th style="min-width:150px;">Actions</th>
                  </tr>
                </thead>

                <tbody>
                  <% submissions.forEach(function(submission) { %>
                    <% const paperId = submission.paper_number != null ? String(submission.paper_number).padStart(4, '0') : '—'; %>
                    <% const modalSuffix = submission.submission_id; %>
                    <tr class="submission-item"
                        data-title="<%= submission.title ? submission.title.toLowerCase() : '' %>"
                        data-track="<%= submission.track_name || '' %>"
                        data-status="<%= submission.submission_status || '' %>"
                        data-author="<%= submission.primary_author_formatted ? submission.primary_author_formatted.toLowerCase() : '' %>"
                        data-coauthors="<%= submission.co_authors_formatted ? submission.co_authors_formatted.toLowerCase() : '' %>"
                        data-papercode="<%= submission.submission_id ? submission.submission_id.toLowerCase() : '' %>">

                      <td class="text-center">
                        <div class="fw-bold mb-2"><%= paperId %></div>
                        <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#detailsModal-<%= modalSuffix %>">
                          <i class="bi bi-file-earmark-text"></i> Details
                        </button>
                      </td>

                      <td><%= submission.track_name || '—' %></td>

                      <td><%= submission.primary_author_formatted %></td>

                      <td><%= submission.co_authors_formatted || '—' %></td>

                      <td class="text-center">
                        <span class="badge
                          <%= submission.submission_status === 'Accepted' ? 'bg-success' :
                              submission.submission_status === 'Rejected' ? 'bg-danger' :
                              submission.submission_status === 'Reviewed' ? 'bg-warning text-dark' :
                              'bg-secondary' %>">
                          <%= submission.submission_status %>
                        </span>
                       </td>

                      <td class="text-center">
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#reviewModal-<%= modalSuffix %>">
                          <i class="bi bi-clipboard-data"></i> Review Details
                        </button>
                      </td>

                      <td class="text-center">
                        <div class="d-grid gap-2">
                          <% if(submission.submission_status!='Submitted for Review' && submission.submission_status!='Submitted Revised Paper') { %>

                            <p class="small" style="color:red">
                              <i class="bi bi-exclamation-circle"></i> Cannot be Deleted
                            </p>

                          <% } else { %>

                            <form method="POST" action="/chair/dashboard/delete-submission/<%= submission.submission_id %>?conference_id=<%= confdata.conference_id %>" class="d-inline"
                             onsubmit="return confirm('Delete this submission? This action cannot be undone.');">
                            <button type="submit" class="btn btn-danger btn-sm">
                            <i class="bi bi-trash"></i> Delete
                            </button>
                          </form>

                            <% } %>

                          <!-- <% if(submission.submission_status!='Submitted for Review' && submission.submission_status!='Submitted Revised Paper' && submission.submission_status!='DESK ACCEPT') { %>
                          <p class="small" style="color:green"><i class="bi bi-check2-circle"></i> Submitted Final Decision</p>
                          <% } else { %>
                          <p class="small text-muted"><i class="bi bi-hourglass-split"></i> Pending Meta-Reviewer Decision</p>
                            <% } %> -->

                        </div>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>

            <!-- Modals rendered outside the table (a <div> is not valid
                 inside <tbody>/<tr> - browsers foster-parent it out and
                 corrupt the table layout when placed there). -->
            <% submissions.forEach(function(submission) { %>
              <% const paperId = submission.paper_number != null ? String(submission.paper_number).padStart(4, '0') : '—'; %>
              <% const modalSuffix = submission.submission_id; %>

              <!-- Modal: Title / Abstract / View Paper -->
              <div class="modal fade" id="detailsModal-<%= modalSuffix %>" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-lg modal-dialog-scrollable">
                  <div class="modal-content">
                    <div class="modal-header">
                      <h5 class="modal-title">Paper <%= paperId %></h5>
                      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                      <h6>Title</h6>
                      <p><%= submission.title %></p>
                      <h6>Abstract</h6>
                      <p style="white-space: pre-wrap;"><%= submission.abstract || 'No abstract provided.' %></p>
                    </div>
                    <div class="modal-footer">
                      <a href="<%= submission.file_url %>" target="_blank" class="btn btn-primary">
                        <i class="bi bi-eye-fill"></i> View Paper
                      </a>
                      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Modal: Review journey + score/remarks -->
              <div class="modal fade" id="reviewModal-<%= modalSuffix %>" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-lg modal-dialog-scrollable">
                  <div class="modal-content">
                    <div class="modal-header">
                      <h5 class="modal-title">Review Journey - Paper <%= paperId %></h5>
                      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                      <div class="journey-track">
                        <% submission.journey.forEach(function(step) { %>
                          <div class="journey-step <%= step.state %>">
                            <div class="journey-line"></div>
                            <div class="journey-dot">
                              <% if (step.state === 'done') { %><i class="bi bi-check-lg"></i>
                              <% } else if (step.state === 'current') { %><i class="bi bi-hourglass-split"></i>
                              <% } else if (step.state === 'rejected') { %><i class="bi bi-x-lg"></i>
                              <% } else if (step.state === 'skipped') { %><i class="bi bi-dash-lg"></i>
                              <% } else { %><i class="bi bi-circle"></i>
                              <% } %>
                            </div>
                            <div class="journey-label"><%= step.label %></div>
                          </div>
                        <% }); %>
                      </div>

                      <hr>

                      <% if (!submission.canShowReviewDetails) { %>
                        <div class="text-center text-muted my-3">
                          <i class="bi bi-eye-slash-fill"></i> Review details are hidden until results are published.
                        </div>
                      <% } else { %>
                        <% if (submission.reviews && submission.reviews.length > 0) { %>
                          <h6>Peer Review</h6>
                          <div class="table-responsive mb-3">
                            <table class="table table-sm table-bordered align-middle">
                              <thead class="table-light"><tr><th style="width:25%;">Reviewer</th><th style="width:15%;">Score</th><th>Remarks</th></tr></thead>
                              <tbody>
                                <% submission.reviews.forEach(function(r) { %>
                                  <tr>
                                    <td><%= r.name || 'Unknown' %></td>
                                    <td><%= r.mean_score != null ? r.mean_score : '—' %></td>
                                    <td><% if (r.remarks) { %><%- sanitizeDescription(r.remarks) %><% } else { %><em class="text-muted">No remarks provided.</em><% } %></td>
                                  </tr>
                                <% }); %>
                              </tbody>
                            </table>
                          </div>
                        <% } %>

                        <% if (submission.revisedReviews && submission.revisedReviews.length > 0) { %>
                          <h6>Re-Review (Revised Paper)</h6>
                          <div class="table-responsive mb-3">
                            <table class="table table-sm table-bordered align-middle">
                              <thead class="table-light"><tr><th style="width:25%;">Reviewer</th><th style="width:15%;">Score</th><th>Remarks</th></tr></thead>
                              <tbody>
                                <% submission.revisedReviews.forEach(function(r) { %>
                                  <tr>
                                    <td><%= r.name || 'Unknown' %></td>
                                    <td><%= r.mean_score != null ? r.mean_score : '—' %></td>
                                    <td><% if (r.remarks) { %><%- sanitizeDescription(r.remarks) %><% } else { %><em class="text-muted">No remarks provided.</em><% } %></td>
                                  </tr>
                                <% }); %>
                              </tbody>
                            </table>
                          </div>
                        <% } %>

                        <% if (submission.remarks) { %>
                          <h6>Meta-Reviewer Decision</h6>
                          <div class="table-responsive mb-3">
                            <table class="table table-sm table-bordered align-middle">
                              <thead class="table-light"><tr><th style="width:30%;">Decision</th><th>Remarks</th></tr></thead>
                              <tbody>
                                <tr>
                                  <td><%= submission.submission_status %></td>
                                  <td><%- sanitizeDescription(submission.remarks) %></td>
                                </tr>
                              </tbody>
                            </table>
                          </div>
                        <% } %>

                        <% if ((!submission.reviews || submission.reviews.length === 0) && (!submission.revisedReviews || submission.revisedReviews.length === 0) && !submission.remarks) { %>
                          <p class="text-muted text-center">No reviews yet.</p>
                        <% } %>
                      <% } %>
                    </div>
                    <div class="modal-footer">
                      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    </div>
                  </div>
                </div>
              </div>
            <% }); %>
          <% } else { %>
            <div id="noSubmissionsMessage" class="text-center my-5">
              <h5 class="text-muted"><i class="bi bi-emoji-frown-fill"></i> No Submissions found.</h5>
            </div>
          <% } %>
        </div>

        <div id="noResultsMessage" class="text-center my-5" style="display: none;">
          <h5 class="text-muted"><i class="bi bi-search"></i> No submissions match your search criteria.</h5>
        </div>
    </div>

    <script src="/script.js"></script>
    <%- include('../partials/footer') %>
    
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        const searchInput = document.getElementById('searchInput');
        const trackFilter = document.getElementById('trackFilter');
        const statusFilter = document.getElementById('statusFilter');
        const clearFiltersBtn = document.getElementById('clearFilters');
        const noResultsMessage = document.getElementById('noResultsMessage');
        const visibleCountSpan = document.getElementById('visibleCount');
        const totalCountSpan = document.getElementById('totalCount');
        const noSubmissionsMessage = document.getElementById('noSubmissionsMessage');

        const submissionItems = document.querySelectorAll('.submission-item');
        const totalSubmissions = submissionItems.length;

        function filterSubmissions() {
          const searchTerm = searchInput.value.toLowerCase().trim();
          const selectedTrack = trackFilter.value;
          const selectedStatus = statusFilter.value;
          
          let visibleCount = 0;
          let hasActiveFilters = searchTerm || selectedTrack || selectedStatus;

          submissionItems.forEach(item => {
            const title = item.getAttribute('data-title') || '';
            const track = item.getAttribute('data-track') || '';
            const status = item.getAttribute('data-status') || '';
            const author = item.getAttribute('data-author') || '';
            const coauthors = item.getAttribute('data-coauthors') || '';
            const papercode = item.getAttribute('data-papercode') || '';

            // Check search term
            const matchesSearch = !searchTerm || 
              title.includes(searchTerm) || 
              author.includes(searchTerm) || 
              coauthors.includes(searchTerm) || 
              papercode.includes(searchTerm);

            // Check track filter
            const matchesTrack = !selectedTrack || track === selectedTrack;

            // Check status filter
            const matchesStatus = !selectedStatus || status === selectedStatus;

            // Show/hide item based on all criteria
            const isVisible = matchesSearch && matchesTrack && matchesStatus;
            item.style.display = isVisible ? '' : 'none'; // Use empty string to retain default table row display

            if (isVisible) visibleCount++;
          });

          // Update results count
          visibleCountSpan.textContent = visibleCount;
          totalCountSpan.textContent = totalSubmissions;

          // Show/hide no results message
          if (visibleCount === 0 && totalSubmissions > 0) {
            noResultsMessage.style.display = 'block';
            if (noSubmissionsMessage) noSubmissionsMessage.style.display = 'none';
          } else {
            noResultsMessage.style.display = 'none';
            if (noSubmissionsMessage && totalSubmissions === 0) {
              noSubmissionsMessage.style.display = 'block';
            }
          }

          // Show/hide clear filters button
          clearFiltersBtn.style.display = hasActiveFilters ? 'inline-block' : 'none';
        }

        function clearAllFilters() {
          searchInput.value = '';
          trackFilter.value = '';
          statusFilter.value = '';
          filterSubmissions();
        }

        // Event listeners
        searchInput.addEventListener('input', filterSubmissions);
        trackFilter.addEventListener('change', filterSubmissions);
        statusFilter.addEventListener('change', filterSubmissions);
        clearFiltersBtn.addEventListener('click', clearAllFilters);

        // Initialize
        filterSubmissions();
      });
    </script>
  </body>
</html>