# =====================
# DATABASE CONFIGURATION
# =====================
DB_USER=
DB_HOST=
DB_NAME=
DB_PASSWORD=
DB_PORT=

# =====================
# SESSION & JWT SECRETS
# =====================
# Generate random strings (minimum 32 characters)
# You can use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
JWT_SECRET=
# Optional: separate secrets per token type (fall back to JWT_SECRET when unset)
JWT_ACCESS_TOKEN_SECRET=
JWT_REFRESH_TOKEN_SECRET=

# =====================
# REDIS (optional; the app runs without it)
# =====================
REDIS_HOST=
REDIS_PORT=
REDIS_USERNAME=
REDIS_PASSWORD=

# =====================
# CLOUDINARY CONFIGURATION
# =====================
# Get from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# =====================
# EMAIL CONFIGURATION
# =====================
# For Gmail: Use App Password (not regular password)
# Get from: https://myaccount.google.com/apppasswords
EMAIL_USER=
EMAIL_PASSWORD=
# Optional sender address shown in outgoing mail (defaults to the built-in sender)
EMAIL_FROM=

# =====================
# APPLICATION SETTINGS
# =====================
# Public base URL used in password reset links, e.g. https://your-domain.example
APP_URL=
NODE_ENV=
PORT=

# =====================
# INSTRUCTIONS
# =====================
# 1. Copy this file: cp .env.example .env
# 2. Replace the empty values above with your actual credentials
# 3. NEVER commit the .env file to Git (it's in .gitignore)
# 4. For production, use strong random secrets for SESSION_SECRET and JWT_SECRET
# 5. Generate secrets: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
