# =====================
# DATABASE CONFIGURATION
# =====================
DB_USER=
DB_HOST=
DB_NAME=
DB_PASSWORD=
DB_PORT=
# Set DB_SSL=true only for a remote server that requires SSL (local PostgreSQL: false)
DB_SSL=false

# =====================
# SESSION & JWT SECRETS
# =====================
# Generate random strings (minimum 32 characters)
# You can use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
JWT_SECRET=
# Optional: separate secrets per token type (fall back to JWT_SECRET when unset)
JWT_ACCESS_TOKEN_SECRET=
JWT_REFRESH_TOKEN_SECRET=

# =====================
# REDIS (optional; the app runs without it)
# =====================
REDIS_HOST=
REDIS_PORT=
REDIS_USERNAME=
REDIS_PASSWORD=

# =====================
# CLOUDINARY CONFIGURATION
# =====================
# Get from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# =====================
# EMAIL CONFIGURATION (Resend - https://resend.com)
# =====================
# From the Resend dashboard: https://resend.com/api-keys
RESEND_API_KEY=
# Must be an address on a domain you've verified in Resend
# (https://resend.com/domains) - Resend rejects sending from a domain it
# hasn't confirmed you own. Falls back to Resend's own sandbox sender
# (onboarding@resend.dev) if unset, which only delivers to the account
# owner's own address - fine for noticing this is unconfigured, not a
# real production default.
EMAIL_FROM="DEI Conference Management Toolkit <cmt@your-verified-domain.example>"

# =====================
# CANVA (certificate generation)
# =====================
# From the Canva Developer Portal (https://www.canva.com/developers/) - the
# redirect URL registered there must be {APP_URL}/admin/canva/callback.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# A separate Brand Template per certificate category (see CANVA_TEMPLATE_IDS
# in api/index.js) - each template's own dataset field names must match
# CANVA_CERTIFICATE_FIELDS in api/index.js. A category whose id is left
# empty here is simply skipped when generating certificates, not an error.
BRAND_TEMPLATE_ID_POSTER=
BRAND_TEMPLATE_ID_PAPER=
BRAND_TEMPLATE_ID_REVIEWER=
BRAND_TEMPLATE_ID_SESSION_CHAIR=
BRAND_TEMPLATE_ID_INVITED_SPEAKER=

# =====================
# APPLICATION SETTINGS
# =====================
# Public base URL used in password reset links, e.g. https://your-domain.example
# Administrator emails (comma-separated, exact match). Admin routes are disabled when empty.
ADMIN_EMAILS=
APP_URL=https://your-production-domain
NODE_ENV=
PORT=

# =====================
# INSTRUCTIONS
# =====================
# 1. Copy this file: cp .env.example .env
# 2. Replace the empty values above with your actual credentials
# 3. NEVER commit the .env file to Git (it's in .gitignore)
# 4. For production, use strong random secrets for SESSION_SECRET and JWT_SECRET
# 5. Generate secrets: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
